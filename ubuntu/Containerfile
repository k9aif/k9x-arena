# K9X Arena — single container: FastAPI serves the API and the static UI
# (web/, plain JS — no front-end build stage).
#
# k9-aif installs from PyPI via requirements.txt. Secrets and settings come
# from .env at run time (--env-file), never baked into the image.
#
# runtime/ (arena.db, the router's k9_model_router.db, uploaded suites) is a
# mounted volume so match history survives rebuilds — see build-run.sh.
#
# Build (from this project's own directory; build-run.sh does this):
#   podman build -t k9x-arena:latest -f ubuntu/Containerfile .

FROM registry.access.redhat.com/ubi9/python-311:latest
USER root

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

COPY . .
# The framework's config loader creates ./logs; runtime/ holds the SQLite files.
RUN mkdir -p /app/runtime /app/logs && chown -R 1001:0 /app/runtime /app/logs && chmod -R g+rwX /app/runtime /app/logs

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ARENA_DB_PATH=/app/runtime/arena.db

EXPOSE 8111

HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8111/api/health')" \
      || exit 1

USER 1001

# Pre-flight first: Ollama reachable, Granite Guardian answering, judge and
# contenders pulled. A failed check stops the container with the reason in
# `build-run.sh logs`.
CMD ["sh", "-c", "python -m arena.preflight && exec uvicorn arena.api:app --host 0.0.0.0 --port 8111 --log-level info"]
