# K9X Arena — environment. Copy to .env; never commit .env.

# Ollama host that serves the contenders, the judge and Granite Guardian
OLLAMA_BASE_URL=http://localhost:11434

# Contenders offered by default in the Lobby (comma-separated Ollama tags).
# Any model pulled on the host can be entered per match.
ARENA_CONTESTANTS=qwen3.8:27b,gemma4:31b,qwen2.5:32b

# Lobby lists only models of at least this size (billions of parameters);
# smaller ones are one click away. Models named above always stay listed.
ARENA_MIN_PARAMS_B=10

# Judge for open-ended answers — must not also be a contender
ARENA_JUDGE_MODEL=deepseek-r1:32b
# Optional second judge for the second pass (fairest when it's a different
# model family from the first judge and from the contenders).
ARENA_JUDGE_MODEL_2=

# Your router config, scored in the router test as the "your rules" baseline
# (only for task types it sends to a model that is competing). Capabilities
# are in config.yaml (arena.router_under_test).
ARENA_ROUTER_GENERAL_MODEL=qwen3.8:27b
ARENA_ROUTER_REASONING_MODEL=gemma4:31b

# Granite Guardian — mandatory in the arena, always fails closed.
#   ollama pull granite4.1-guardian:8b
ARENA_GUARDIAN_MODEL=granite4.1-guardian:8b

# Web UI
ARENA_PORT=8111
ARENA_USER=demo
ARENA_PASSWORD=demo
# Admin can settle review items and delete matches. Leave the password
# empty to disable the admin login.
ARENA_ADMIN_USER=admin
ARENA_ADMIN_PASSWORD=

# Storage
ARENA_DB_PATH=./runtime/arena.db

# Framework governance mode (production = governance must be real)
K9_ENV=production
